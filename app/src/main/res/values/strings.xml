    <string name="red_flags_title">🚨 Critical Adverse Reaction Red Flags:</string>
    <string name="ss_title">Serotonin Syndrome (SS)</string>
    <string name="ss_drugs">SSRIs, SNRIs, Tramadol, Triptans, MAOIs</string>
    <string name="ss_symptoms">Agitation, confusion, rapid heart rate, shivering, severe muscle stiffness, tremors, high fever, and seizure.</string>
    <string name="bleed_title">Severe Internal Bleeding</string>
    <string name="bleed_drugs">Warfarin, DOACs (Eliquis, Xarelto), Aspirin, NSAIDs</string>
    <string name="bleed_symptoms">Black tarry stools, coughing up blood, vomiting coffee-ground emesis, unusual weakness, severe persistent headache.</string>
    <string name="angio_title">Severe Angioedema &amp; Airway Closure</string>
    <string name="angio_drugs">ACE Inhibitors (Lisinopril, Enalapril), ARBs</string>
    <string name="angio_symptoms">Rapid swelling of lips, tongue, throat, face, or larynx causing stridor and shortness of breath. Call 911 immediately.</string>
    <string name="rhabdo_title">Severe Rhabdomyolysis</string>
    <string name="rhabdo_drugs">Statins combined with Macrolides or Azoles</string>
    <string name="rhabdo_symptoms">Severe diffuse muscle pain, profound weakness, and dark tea-colored urine indicating myoglobinuria.</string>
    <string name="pharmacist_questions_title">📋 5 Questions to Ask Your Pharmacist:</string>
    <string name="pq1_q">Does this interact with any of my current prescription or OTC medications?</string>
    <string name="pq1_tip">Always bring a complete list of your current medicines, including vitamins, antacids, and herbal supplements.</string>
    <string name="pq2_q">Are there specific foods, juices, or alcohol I need to avoid?</string>
    <string name="pq2_tip">Common triggers include grapefruit, calcium/dairy products, potassium salt substitutes, and alcohol.</string>
    <string name="pq3_q">What should I do if I accidentally miss a dose?</string>
    <string name="pq3_tip">Never double up on doses without explicit instructions from your pharmacist or prescriber.</string>
    <string name="pq4_q">What are the early warning signs of an adverse reaction?</string>
    <string name="pq4_tip">Understand the difference between mild temporary side effects and urgent red flags requiring emergency care.</string>
    <string name="pq5_q">Does this medication require periodic laboratory monitoring?</string>
    <string name="pq5_tip">Drugs like Warfarin (INR), Lisinopril (Potassium/Creatinine), Digoxin, and Lithium need scheduled blood tests.</string>
    <string name="disclaimer_title">Government Open Data &amp; Medical Disclaimer</string>
    <string name="disclaimer_body">RxSafety references 100% free public domain data from the US National Library of Medicine (NIH RxNav) and the US Food and Drug Administration (OpenFDA). This application is intended for educational and clinical screening purposes and does not substitute for professional medical judgment. Always consult a licensed physician or pharmacist regarding medication regimen changes.</string>

